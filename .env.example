BACKBOARD_API_KEY=
# Testing: lift the one-run-per-day limit
# DEV_UNLIMITED=1
# Global message cap for all players per Toronto day (default 3000)
# MAX_DAILY_MESSAGES=3000
# Supabase Postgres (Connect > Transaction pooler string). Unset = local SQLite file below
# DATABASE_URL=
# SQLite file (default nexus.db; /tmp/nexus.db on Vercel)
# NEXUS_DB=nexus.db
# Override the model for every mode
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-5-5
# Path of the friends-pass link that lifts the daily limit (default unlimited)
# UNLIMITED_SLUG=unlimited
